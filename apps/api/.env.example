# Copier en .env (ignoré par Git) et renseigner les valeurs.
# Ne jamais commiter de vraie clé.

# Clé API Twelve Data : https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=

# PostgreSQL local (docker compose up -d à la racine du repo)
DATABASE_URL=postgresql://cloudpulse:cloudpulse@localhost:5432/cloudpulse

# Optionnel
# PORT=8080
# DATABASE_POOL_MAX=5
# QUOTE_TTL_SECONDS=300
# TWELVE_DATA_BASE_URL=https://api.twelvedata.com
# TWELVE_DATA_TIMEOUT_MS=5000

# Mode ingestion (APP_MODE=ingest) : voir apps/api/README.md
# APP_MODE=ingest
# INGESTION_QUEUE=projects/PROJET/locations/europe-west9/queues/ingest-quotes
# INGESTION_TARGET_URL=https://cloudpulse-ingest-xxxx.a.run.app
# INGESTION_INVOKER_SA=cloudpulse-tasks-invoker@PROJET.iam.gserviceaccount.com
# INGESTION_HISTORY_DAYS=5
